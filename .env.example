# ============================================================
# AA Pulse — Anime Adventures Value Tracker (.env.example)
# Скопируйте этот файл в .env.local и заполните своими ключами
# ============================================================

# ID публичной Google Таблицы с прайс-листом Anime Adventures
GOOGLE_SHEET_ID=1KTVAqVw26TkwJF7GGJmKjkVEXCK5itqS1OZAIpqxuJ0

# Google Gemini API (для AI-аналитики рынка в /api/analyze-unit)
# Получить ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (для хранения базы персонажей, истории цен и кэша AI-анализов)
# После создания проекта выполните SQL из файла supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Секретный токен для защиты POST /api/sync-supabase (используется также в GitHub Actions)
SYNC_SECRET_TOKEN=
